# OpenAI-compatible API key; leave empty to disable the LLM.
OPENAI_API_KEY=
# Optional OpenAI-compatible API base URL.
OPENAI_BASE_URL=
# LLM model name.
LLM_MODEL_NAME=gpt-4o-mini
# LLM provider: openai or gemma.
LLM_PROVIDER=openai

# Lexicon JSON path.
VOCABZERO_DICTIONARY=lexicon.json
# ChromaDB path; leave empty to disable the vector database.
VOCABZERO_VECTOR_DB=

# Audio normalization toggles.
VOCABZERO_CMVN=true
VOCABZERO_VTLN=true
VOCABZERO_LIFTERING=true
VOCABZERO_DELTAS=true

# Acoustic matching thresholds.
VOCABZERO_DTW_THRESHOLD_36=1.8
VOCABZERO_DTW_THRESHOLD_12=1.2
VOCABZERO_MIN_CONFIDENCE=0.6
VOCABZERO_AMBIGUITY_MARGIN_RATIO=0.15
VOCABZERO_AMBIGUITY_CONFIDENCE_FLOOR=0.4
VOCABZERO_DTW_BAND_RATIO=0.2
VOCABZERO_MAX_LENGTH_RATIO=2.5
VOCABZERO_TEMPLATE_AGG_K=3
